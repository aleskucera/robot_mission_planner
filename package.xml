<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_mission_planner</name>
  <version>0.0.1</version>
  <description>Robot Mission Planner</description>
  <maintainer email="kuceral4@fel.cvut.cz">Kucera Ales</maintainer>
  <maintainer email="vlkjan6@fel.cvut.cz">Vlk Jan</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros2_numpy</exec_depend>
  <!-- crl_commander provides the SwitchMode / ConfigureSequenceMode services (nav_backend=commander).
       On the robot it is the real package in adam_ws; in a dev workspace use the interface stub. -->
  <exec_depend>crl_commander</exec_depend>
  <exec_depend>python3-gpxpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>  <!-- qr_goal -->
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-utm</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
