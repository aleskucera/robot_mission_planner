<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Waypoint following, no road: the follower in its gps mode. Kept as the name the old
       gps_follower_ros2 node was launched under; the waypoints are a GPX/YAML file, or a
       route planned from a QR goal when no file is given. -->
  <arg name="gps_file" default="" />
  <arg name="nav_backend" default="" />

  <include file="$(find-pkg-share robot_mission_planner)/launch/follower.launch.py">
    <arg name="mode" value="gps" />
    <arg name="gps_file" value="$(var gps_file)" />
    <arg name="nav_backend" value="$(var nav_backend)" />
  </include>
</launch>
