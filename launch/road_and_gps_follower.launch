<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Follower in road_gps mode (legacy alias for tmux/replay scripts) -->
  <arg name="gps_file" default="" />
  <arg name="nav_backend" default="" />
  <arg name="road_goal_source" default="" />
  <arg name="carrot_topic" default="" />
  <arg name="config" default="$(find-pkg-share robot_mission_planner)/config/follower.yaml" />

  <include file="$(find-pkg-share robot_mission_planner)/launch/follower.launch.py">
    <arg name="mode" value="road_gps" />
    <arg name="config" value="$(var config)" />
    <arg name="gps_file" value="$(var gps_file)" />
    <arg name="nav_backend" value="$(var nav_backend)" />
    <arg name="road_goal_source" value="$(var road_goal_source)" />
    <arg name="carrot_topic" value="$(var carrot_topic)" />
  </include>
</launch>
