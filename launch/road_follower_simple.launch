<?xml version="1.0" encoding="UTF-8"?>
<!-- Plain road following: road-centre point/path straight into the controller.
     No intersections, no GPS - for that use road_and_gps_follower.launch.
     Goal mode, topics and distances live in the config file. -->
<launch>
  <arg name="config" default="$(find-pkg-share robot_mission_planner)/config/road_follower_simple.yaml" />

  <node pkg="robot_mission_planner" exec="road_follower_simple" name="road_follower_simple" output="screen">
      <param from="$(var config)" />
  </node>
</launch>
